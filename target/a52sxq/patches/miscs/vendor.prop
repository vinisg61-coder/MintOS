# Adaptive Refresh Rate - 120Hz extremo no talo
ro.surface_flinger.use_content_detection=true
ro.surface_flinger.set_idle_timer_ms=2000
ro.surface_flinger.set_touch_timer_ms=300
ro.surface_flinger.set_display_power_timer_ms=500
ro.surface_flinger.use_smart_90_for_video=true
ro.surface_flinger.refresh_rate_switching=true

# Kernel / QTI extremo - 778G no talo
ro.vendor.qti.sys.fw.bservice_enable=true
ro.vendor.qti.sys.fw.bservice_limit=80
ro.vendor.qti.sys.fw.bservice_age=5000
ro.vendor.qti.am.reschedule_service=true
ro.vendor.perf.scroll_opt=true
ro.vendor.qti.cgroup_follow=true
ro.vendor.qti.sys.fw.use_trim_settings=true
ro.vendor.qti.sys.fw.trim_enable_memory=80
ro.vendor.qti.sys.fw.trim_empty_percent=50
persist.vendor.qcomsysd.enabled=0
persist.vendor.ssr.enable_ramdumps=0
vidc.debug.perf.mode=2
ro.vendor.display.ad=1
ro.vendor.display.sensortype=2
